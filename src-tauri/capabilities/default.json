{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Nousetsu desktop app",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:15474"]
  },
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "allow-stop-backend-before-update"
  ]
}
