{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nousetsu",
  "version": "0.4.0",
  "identifier": "com.nousetsu.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "npm --prefix web run build && uv run --no-sync python src-tauri/build_sidecar.py",
      "cwd": ".."
    },
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nousetsu — Literary Translation Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/nousetsu-backend/": "binaries/nousetsu-backend/",
      "../.env.example": "defaults/.env.example"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
