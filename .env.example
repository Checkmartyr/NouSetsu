# ==============================================================================
# NouSetsu - Novel Translation Agent Environment Configuration Template
# Copy this file to .env and configure your API keys and model preferences.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for Gemini and Gemma models)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Provider Keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Central Model Selection
# ------------------------------------------------------------------------------
# Default LLM model used across the pipeline when not specialized
DEFAULT_MODEL=gemini-3.1-flash-lite
NOVEL_MODEL=gemini-3.1-flash-lite

# Global Fallback Model (used automatically if primary model hits 429 quota or errors)
NOVEL_FALLBACK_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Multi-Agent Specialized Model Routing
# ------------------------------------------------------------------------------
# Entity Extractor Agent: extracts character profiles, relationships, terms
NOVEL_EXTRACTOR_MODEL=gemini-3.1-flash-lite

# Context-Aware Drafter Agent: performs initial chapter translation
NOVEL_DRAFTER_MODEL=gemini-3.5-flash-lite

# Critique & Auditor Agent: detects fidelity errors, mistranslations, hallucinations
NOVEL_CRITIC_MODEL=gemma-4-26b-a4b-it

# Prose Polisher Agent: refines style, tone, literary flow, and fluency
NOVEL_POLISHER_MODEL=gemini-3.5-flash-lite

# Chronicler Lore Memory Agent: updates Novel Bible memory with chapter events
NOVEL_CHRONICLER_MODEL=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# API Execution & Performance Tuning
# ------------------------------------------------------------------------------
# Use Gemini Interactions API endpoint (/v1beta/interactions)
NOVEL_USE_INTERACTIONS=1

# Rate limiting quotas
NOVEL_MAX_TPM=32000
NOVEL_MAX_RPM=60

# Translation refinement loop bounds
NOVEL_MAX_REVIEW_LOOPS=3
NOVEL_QUALITY_THRESHOLD=8.5

# ------------------------------------------------------------------------------
# Default Language Pair
# ------------------------------------------------------------------------------
SOURCE_LANG=Japanese
TARGET_LANG=Thai
