[
  {
    "model": "audit-extractor",
    "temperature": 0.1,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "schema": {
          "$defs": {
            "CharacterNameDetail": {
              "description": "Linguistic components of a character's personal name.",
              "properties": {
                "name": {
                  "default": "",
                  "description": "Given / first name (e.g. 'Mary' or 'メアリィ' or '炎')",
                  "title": "Name",
                  "type": "string"
                },
                "m_name": {
                  "default": "",
                  "description": "Middle name or noble connector (e.g. 'Lukia' or 'ルクア' or 'von')",
                  "title": "M Name",
                  "type": "string"
                },
                "s_name": {
                  "default": "",
                  "description": "Surname / family / clan name (e.g. 'Legalia' or 'レガリヤ' or '萧')",
                  "title": "S Name",
                  "type": "string"
                }
              },
              "title": "CharacterNameDetail",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "m_name",
                "s_name"
              ]
            },
            "CharacterNames": {
              "description": "Structured name components mapped across source and target languages.",
              "properties": {
                "source": {
                  "description": "Name components in source language native script",
                  "properties": {
                    "name": {
                      "default": "",
                      "description": "Given / first name (e.g. 'Mary' or 'メアリィ' or '炎')",
                      "title": "Name",
                      "type": "string"
                    },
                    "m_name": {
                      "default": "",
                      "description": "Middle name or noble connector (e.g. 'Lukia' or 'ルクア' or 'von')",
                      "title": "M Name",
                      "type": "string"
                    },
                    "s_name": {
                      "default": "",
                      "description": "Surname / family / clan name (e.g. 'Legalia' or 'レガリヤ' or '萧')",
                      "title": "S Name",
                      "type": "string"
                    }
                  },
                  "title": "CharacterNameDetail",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "m_name",
                    "s_name"
                  ]
                },
                "target": {
                  "description": "Name components in target translation language",
                  "properties": {
                    "name": {
                      "default": "",
                      "description": "Given / first name (e.g. 'Mary' or 'メアリィ' or '炎')",
                      "title": "Name",
                      "type": "string"
                    },
                    "m_name": {
                      "default": "",
                      "description": "Middle name or noble connector (e.g. 'Lukia' or 'ルクア' or 'von')",
                      "title": "M Name",
                      "type": "string"
                    },
                    "s_name": {
                      "default": "",
                      "description": "Surname / family / clan name (e.g. 'Legalia' or 'レガリヤ' or '萧')",
                      "title": "S Name",
                      "type": "string"
                    }
                  },
                  "title": "CharacterNameDetail",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "m_name",
                    "s_name"
                  ]
                }
              },
              "title": "CharacterNames",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "target"
              ]
            },
            "CharacterProfile": {
              "properties": {
                "name": {
                  "default": "",
                  "description": "Standard translated character name",
                  "title": "Name",
                  "type": "string"
                },
                "original_name": {
                  "default": "",
                  "description": "Original raw name in source text",
                  "title": "Original Name",
                  "type": "string"
                },
                "names": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/CharacterNames"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Structured name components (name, m_name, s_name) in source and target languages"
                },
                "aliases": {
                  "description": "Known nicknames, aliases, titles",
                  "items": {
                    "type": "string"
                  },
                  "title": "Aliases",
                  "type": "array"
                },
                "gender": {
                  "default": "unspecified",
                  "description": "Gender identity for pronoun consistency",
                  "title": "Gender",
                  "type": "string"
                },
                "role": {
                  "default": "supporting",
                  "description": "Role e.g. protagonist, antagonist, supporting, mentor",
                  "title": "Role",
                  "type": "string"
                },
                "voice": {
                  "default": "neutral",
                  "description": "Tone register, speech quirks, formality level",
                  "title": "Voice",
                  "type": "string"
                },
                "relationships": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Relationship map e.g. {'Elena': 'sister'}",
                  "title": "Relationships",
                  "type": "object"
                },
                "pronouns": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/CharacterPronouns"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Source and target language pronouns for zero-anaphora and dialogue consistency"
                }
              },
              "title": "CharacterProfile",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "original_name",
                "names",
                "aliases",
                "gender",
                "role",
                "voice",
                "relationships",
                "pronouns"
              ]
            },
            "CharacterPronouns": {
              "properties": {
                "source": {
                  "default": "",
                  "description": "Source language pronoun(s) (e.g. 'she/her', 'watashi', 'I')",
                  "title": "Source",
                  "type": "string"
                },
                "target": {
                  "default": "",
                  "description": "Target language pronoun(s) (e.g. 'เธอ', 'ฉัน', 'เขา', 'ผม')",
                  "title": "Target",
                  "type": "string"
                },
                "relational": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Relational pronouns/address with specific characters e.g. {'Amelia Barlen': 'หนู/พี่'}",
                  "title": "Relational",
                  "type": "object"
                }
              },
              "title": "CharacterPronouns",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "target",
                "relational"
              ]
            },
            "GlossaryItem": {
              "properties": {
                "source": {
                  "description": "Original term in source language",
                  "title": "Source",
                  "type": "string"
                },
                "target": {
                  "description": "Canonical translated term",
                  "title": "Target",
                  "type": "string"
                },
                "category": {
                  "default": "term",
                  "description": "Category: character, faction, location, skill, item, rank, term",
                  "title": "Category",
                  "type": "string"
                },
                "notes": {
                  "default": "",
                  "description": "Contextual guidance or etymology",
                  "title": "Notes",
                  "type": "string"
                }
              },
              "required": [
                "source",
                "target",
                "category",
                "notes"
              ],
              "title": "GlossaryItem",
              "type": "object",
              "additionalProperties": false
            }
          },
          "description": "Structured extraction output from EntityExtractorAgent.",
          "properties": {
            "new_characters": {
              "description": "Newly identified characters appearing in the chapter text with pronouns, role, and voice",
              "items": {
                "$ref": "#/$defs/CharacterProfile"
              },
              "title": "New Characters",
              "type": "array"
            },
            "new_terms": {
              "description": "Newly identified terms, cultivation realms, locations, items, or factions",
              "items": {
                "$ref": "#/$defs/GlossaryItem"
              },
              "title": "New Terms",
              "type": "array"
            },
            "active_terms_in_chapter": {
              "description": "Source terms from the known glossary actively present in this chapter",
              "items": {
                "type": "string"
              },
              "title": "Active Terms In Chapter",
              "type": "array"
            }
          },
          "title": "ExtractorResult",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_characters",
            "new_terms",
            "active_terms_in_chapter"
          ]
        },
        "name": "ExtractorResult",
        "strict": true
      }
    },
    "stream": false
  },
  {
    "model": "audit-drafter",
    "temperature": 0.2,
