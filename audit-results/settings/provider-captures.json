  {
    "model": "audit-critic",
    "temperature": 0.3,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "schema": {
          "description": "Structured audit output from CritiqueAgent.",
          "properties": {
            "fidelity_score": {
              "default": 8.0,
              "description": "Strict translation fidelity score from 0.0 to 10.0 assessing omissions, accuracy, and register",
              "title": "Fidelity Score",
              "type": "number"
            },
            "style_score": {
              "default": 7.8,
              "description": "Target language prose style score from 0.0 to 10.0 assessing cadence, natural flow, and dialogue voice",
              "title": "Style Score",
              "type": "number"
            },
            "glossary_compliance_pct": {
              "default": 100.0,
              "description": "Percentage of glossary adherence (0.0 to 100.0)",
              "title": "Glossary Compliance Pct",
              "type": "number"
            },
            "warnings": {
              "description": "Specific errors, ambiguities, dropped clauses, or glossary mismatches",
              "items": {
                "type": "string"
              },
              "title": "Warnings",
              "type": "array"
            },
            "critique_notes": {
              "default": "",
              "description": "Granular, line-by-line actionable feedback and diff recommendations for the PolishingAgent",
              "title": "Critique Notes",
              "type": "string"
            }
          },
          "title": "CritiqueResult",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fidelity_score",
            "style_score",
            "glossary_compliance_pct",
            "warnings",
            "critique_notes"
          ]
        },
        "name": "CritiqueResult",
        "strict": true
      }
    },
    "stream": false
  },
